---

<Layout title="Jack Mielke | Cyberdeck Interface">
  <div class="terminal-nav">
    <div class="nav-tabs">
      <button class="tab-btn active" data-tab="bio">BIO</button>
      <button class="tab-btn" data-tab="projects">PROJECTS</button>
      <button class="tab-btn" data-tab="articles">ARTICLES</button>
      <button class="tab-btn" data-tab="contact">CONTACT</button>
    </div>
  </div>
  
  <!-- Bio tab (default view) -->
  <div class="tab-content active" id="bio-content">
    <div class="user-profile data-box">
      <div class="profile-header">
        <div class="profile-image-container">
          <img src="/Muay Thai Jack.jpg" alt="Jack Mielke" class="profile-image" />
          <div class="profile-image-overlay"></div>
        </div>
        <div class="profile-info">
          <h1 class="profile-name"># JACK MIELKE <span class="blink">_</span></h1>
          <p class="profile-title">:: Creative Developer & AI Whisperer</p>
          <div class="system-status">
            <span class="status-item">Status: <span class="status-active">ACTIVE</span></span>
            <span class="status-item">Uptime: 10950 days</span>
            <span class="status-item">Location: [REDACTED]</span>
          </div>
        </div>
      </div>
      <div class="profile-links">
        {socialLinks.map(link => (
          <a href={link.url} target="_blank" rel="noopener noreferrer" class="social-link">
            <svg class="social-icon" viewBox="0 0 24 24">
              <path fill="currentColor" d={link.icon}></path>
            </svg>
            <span class="social-label">{link.platform}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="biometric-data data-box">
      <div class="data-heading">
        <span class="data-icon">⟁</span> CURRENT INTERESTS
      </div>
      <ul class="data-list">
        <li class="data-item">
          <span class="item-label">Primary Focus:</span>
          <span class="item-value"><a href="https://open.substack.com/pub/jackmielke/p/life-at-the-edge">Popup Cities</a> &amp; Decentralized Communities</span>
        </li>
        <li class="data-item">
          <span class="item-label">Daily Operations:</span>
          <span class="item-value">Building 5+ AI-powered applications</span>
        </li>
        <li class="data-item">
          <span class="item-label">System Maintenance:</span>
          <span class="item-value">Optimizing health &amp; physical performance</span>
        </li>
      </ul>
      <div class="typing-effect">
        <span id="typing-text"></span><span class="cursor">█</span>
      </div>
    </div>
  </div>

  <!-- Projects tab -->
  <div class="tab-content" id="projects-content">
    <div class="terminal-header-small">
      <div class="header-prefix">$</div>
      <div class="header-text">SELECT * FROM projects ORDER BY priority DESC</div>
    </div>
    
    <div class="projects-grid">
      {projects.map(project => (
        <div class="project-card data-box">
          <div class="project-title">
            <span class="project-icon">⌘</span>
            <a href={project.url} target="_blank" class="project-link">{project.title}</a>
          </div>
          <div class="iframe-container">
            <div class="iframe-overlay">
              <div class="loading-text">INITIALIZING PREVIEW...</div>
            </div>
            <iframe 
              src={project.url}
              title={project.title}
              loading="lazy"
              class="project-iframe"
            ></iframe>
          </div>
          <p class="project-desc">{project.description}</p>
          <div class="project-tech">
            {project.techStack && project.techStack.map(tech => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>
          <div class="card-footer">
            <span class="cmd-prompt">$ open project</span>
            <a href={project.url} target="_blank" class="card-btn">LAUNCH</a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Articles tab -->
  <div class="tab-content" id="articles-content">
    <div class="terminal-header-small">
      <div class="header-prefix">$</div>
      <div class="header-text">cat ~/writing/publications.md</div>
    </div>
    
    <div class="featured-article data-box">
      <div class="article-metadata">
        <span class="article-date">{featuredPost.date}</span>
        <span class="article-time">{featuredPost.readTime}</span>
        <span class="article-status">FEATURED</span>
      </div>
      <h2 class="article-title">
        <a href={featuredPost.url} target="_blank">{featuredPost.title}</a>
      </h2>
      <p class="article-desc">{featuredPost.description}</p>
      <div class="article-image-container">
                <img 
                  src={featuredPost.imagePath} 
          alt="Featured article" 
          class="article-image"
        />
        <div class="article-image-overlay"></div>
      </div>
    </div>
    
    <div class="articles-list">
      {posts.map(post => (
        <div class="article-item data-box">
          <div class="article-metadata">
            <span class="article-date">{post.date}</span>
            <span class="article-time">{post.readTime}</span>
          </div>
          <h3 class="article-title-small">
            <a href={post.url} target="_blank">{post.title}</a>
          </h3>
          <p class="article-desc-small">{post.description}</p>
          <div class="card-footer">
            <span class="cmd-prompt">$ read article</span>
            <a href={post.url} target="_blank" class="card-btn">OPEN</a>
          </div>
        </div>
      ))}
              </div>
            </div>
  
  <!-- Contact tab -->
  <div class="tab-content" id="contact-content">
    <div class="terminal-header-small">
      <div class="header-prefix">$</div>
      <div class="header-text">contact --init</div>
    </div>

    <div class="contact-info data-box">
      <div class="data-heading">
        <span class="data-icon">☍</span> COMMUNICATION CHANNELS
      </div>
      <div class="contact-message">
        <p class="message-line">For consulting, web development work, or any specific questions, send a direct transmission to:</p>
        <div class="code-block">
          <span class="code-line">$ send_message "<a href="mailto:jackcmielke@gmail.com" class="highlighted">jackcmielke@gmail.com</a>"</span>
        </div>
      </div>
      <div class="divider"><span>or</span></div>
      <div class="resume-link">
        <p class="message-line">Access complete system specifications:</p>
        <div class="code-block">
          <span class="code-line">$ download <a href="https://jackmielke.notion.site/Jack-Mielke-f5229540843445c591b0ffbd4d3f8ba5?pvs=4" target="_blank" class="highlighted">resume.pdf</a></span>
        </div>
      </div>
    </div>
    
    <div class="matrix-rain-container">
      <canvas id="matrix-rain"></canvas>
    </div>
  </div>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Tab switching
    const tabButtons = document.querySelectorAll('.tab-btn');
    const tabContents = document.querySelectorAll('.tab-content');
    
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        const tabName = button.getAttribute('data-tab');
        
        // Update buttons
        tabButtons.forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');
        
        // Update content
        tabContents.forEach(content => content.classList.remove('active'));
        document.getElementById(`${tabName}-content`).classList.add('active');
      });
    });

    // Typing effect
    const textElement = document.getElementById("typing-text");
    const text = "I'm currently exploring the intersection of AI, community building, and digital nomadism. My systems are optimized for rapid prototyping and creative problem-solving.";
    let index = 0;
    let isDeleting = false;
    let typingSpeed = 50;

    function type() {
      const currentText = text.substring(0, index);
      textElement.textContent = currentText;
      
      if (!isDeleting && index < text.length) {
        index++;
        typingSpeed = Math.random() * 50 + 50;
      } else if (isDeleting && index > 0) {
        index--;
        typingSpeed = 30;
      } else {
        isDeleting = !isDeleting;
        typingSpeed = isDeleting ? 1000 : 1000;
      }
      
      setTimeout(type, typingSpeed);
    }
    
    setTimeout(type, 1000);

    // Matrix rain effect for contact page
    const matrix = document.getElementById('matrix-rain');
    if (matrix) {
      const ctx = matrix.getContext('2d');
      
      // Make canvas full size of its container
      function resizeCanvas() {
        const container = document.querySelector('.matrix-rain-container');
        if (container) {
          matrix.width = container.offsetWidth;
          matrix.height = container.offsetHeight;
        }
      }
      
      resizeCanvas();
      window.addEventListener('resize', resizeCanvas);
      
      // Matrix rain characters
      const characters = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン';
      const columns = matrix.width / 15;
      const drops = [];
      
      // Initialize drops
      for (let i = 0; i < columns; i++) {
        drops[i] = Math.floor(Math.random() * -20);
      }
      
      // Draw the matrix
      function drawMatrix() {
        // Semi-transparent black to create trail effect
        ctx.fillStyle = 'rgba(10, 10, 15, 0.05)';
        ctx.fillRect(0, 0, matrix.width, matrix.height);
        
        ctx.fillStyle = '#40e0d0';
        ctx.font = '15px monospace';
        
        for (let i = 0; i < drops.length; i++) {
          // Random character
          const text = characters[Math.floor(Math.random() * characters.length)];
          
          // Draw character
          ctx.fillText(text, i * 15, drops[i] * 15);
          
          // Move drop down
          if (drops[i] * 15 > matrix.height && Math.random() > 0.98) {
            drops[i] = 0;
          }
          
          drops[i]++;
        }
      }
      
      // Contact tab animation
      const contactTab = document.querySelector('[data-tab="contact"]');
      contactTab.addEventListener('click', () => {
        setInterval(drawMatrix, 80);
      });
    }
  });
</script>

<style>
  /* Terminal Navigation */
  .terminal-nav {
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(64, 224, 208, 0.3);
  }

  .nav-tabs {
    display: flex;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .tab-btn {
    background: none;
    border: none;
    color: rgba(194, 230, 233, 0.7);
    padding: 0.5rem 1.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    letter-spacing: 1px;
  }

  .tab-btn:hover {
    color: rgba(194, 230, 233, 1);
  }

  .tab-btn.active {
    color: var(--terminal-glow);
  }

  .tab-btn.active::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -6px;
    width: 100%;
    height: 2px;
    background-color: var(--terminal-glow);
    box-shadow: 0 0 10px rgba(64, 224, 208, 0.5);
  }

  /* Tab content */
  .tab-content {
    display: none;
    animation: fadeIn 0.5s ease forwards;
  }

  .tab-content.active {
    display: block;
  }

  /* Bio tab */
  .user-profile {
    margin-bottom: 2rem;
  }

  .profile-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .profile-image-container {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(64, 224, 208, 0.3);
  }

  .profile-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .profile-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(10, 10, 15, 0.2) 0%, rgba(64, 224, 208, 0.1) 100%);
    pointer-events: none;
  }

  .profile-info {
    flex: 1;
  }

  .profile-name {
    color: var(--terminal-glow);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 1px;
    margin-bottom: 0.5rem;
  }

  .profile-title {
    color: rgba(194, 230, 233, 0.8);
    margin-bottom: 1rem;
    font-size: 1rem;
  }

  .system-status {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.8rem;
    color: rgba(194, 230, 233, 0.6);
  }

  .status-active {
    color: #50fa7b;
  }

  .profile-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: 4px;
    background-color: rgba(64, 224, 208, 0.1);
    transition: all 0.3s ease;
    font-size: 0.8rem;
  }

  .social-link:hover {
    background-color: rgba(64, 224, 208, 0.2);
    box-shadow: 0 0 10px rgba(64, 224, 208, 0.2);
  }

  .social-icon {
    width: 16px;
    height: 16px;
  }

  .social-label {
    text-transform: capitalize;
  }

  /* Biometric data */
  .biometric-data {
    margin-bottom: 2rem;
  }

  .data-icon {
    color: var(--terminal-glow);
    margin-right: 0.5rem;
  }

  .data-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
  }

  .data-item {
    margin-bottom: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item-label {
    color: rgba(194, 230, 233, 0.6);
    font-size: 0.85rem;
  }

