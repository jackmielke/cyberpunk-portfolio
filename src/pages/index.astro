    background-color: rgba(10, 10, 15, 0.5);
    border: 1px solid rgba(64, 224, 208, 0.2);
    border-radius: 4px;
    font-size: 0.9rem;
    color: rgba(194, 230, 233, 0.9);
    line-height: 1.6;
  }

  .cursor {
    animation: blink 1s infinite;
  }

  /* Projects tab */
  .terminal-header-small {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
    padding: 0.5rem 1rem;
    background-color: rgba(12, 30, 38, 0.8);
    border-radius: 4px;
  }

  .header-prefix {
    color: #50fa7b;
    margin-right: 0.5rem;
  }

  .header-text {
    color: rgba(194, 230, 233, 0.9);
    font-size: 0.9rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  .project-icon {
    color: var(--terminal-glow);
    margin-right: 0.5rem;
  }

  .project-title {
    display: flex;
    align-items: center;
    font-weight: 600;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .project-desc {
    color: rgba(194, 230, 233, 0.8);
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.6;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .tech-tag {
    padding: 0.25rem 0.5rem;
    background-color: rgba(64, 224, 208, 0.1);
    border-radius: 4px;
    font-size: 0.75rem;
    color: rgba(194, 230, 233, 0.9);
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid rgba(64, 224, 208, 0.2);
  }

  .cmd-prompt {
    color: rgba(194, 230, 233, 0.6);
    font-size: 0.8rem;
  }

  .card-btn {
    padding: 0.25rem 0.75rem;
